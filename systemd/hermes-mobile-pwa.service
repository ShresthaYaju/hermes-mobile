# The hermes-mobile proxy.
#
# PATHS: this unit assumes the clone is at ~/hermes-mobile and that node is at
# ~/.local/bin/node. Check `which node` and edit ExecStart and WorkingDirectory
# if yours differ, or systemd fails with 203/EXEC.
#
# HERMES_DASHBOARD_SESSION_TOKEN and HERMES_MOBILE_ALLOWED_LOGINS come from the
# 0600 EnvironmentFile below. The server refuses to start without an allowlist.

[Unit]
Description=Hermes Mobile PWA proxy
# Ordered after the backend, but deliberately not `Wants=` on it: the proxy is
# designed to start and answer 502 while the backend is down or restarting,
# not to fail to start alongside it.
After=network-online.target hermes-mobile-backend.service
Wants=network-online.target

# Do not let a crash loop burn into a permanently failed state that survives
# reboot and needs `systemctl --user reset-failed` to clear.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/hermes-mobile-pwa.env
WorkingDirectory=%h/hermes-mobile
Environment=HOST=127.0.0.1
Environment=PORT=4174
Environment=HERMES_ORIGIN=http://127.0.0.1:9119
ExecStart=%h/.local/bin/node %h/hermes-mobile/server.mjs
Restart=on-failure
RestartSec=3
# The process's own SIGTERM handler force-closes every connection and exits
# well inside this; it exists as a backstop so a restart cannot still end up
# waiting out the default 90s TimeoutStopSec before systemd sends SIGKILL.
TimeoutStopSec=10

# This process terminates a network path from the tailnet, so give it as little
# of the machine as it can run with. It only ever needs to read its own
# directory, write the push-subscription file under ~/.local/state, and open
# TCP sockets on loopback.
#
# PrivateDevices=, ProtectClock= and ProtectKernelModules= are deliberately
# absent. Each one implies a CapabilityBoundingSet= drop, and dropping bounding
# set capabilities needs CAP_SETPCAP, which a `--user` manager does not have.
# systemd fails the unit at step CAPABILITIES with 218/CAPABILITIES before node
# ever runs, and an explicit CapabilityBoundingSet= cannot buy them back: the
# implication is applied after the whole unit is parsed, so it always wins.
# Little is actually lost. The process starts with an empty capability set and
# NoNewPrivileges=true means it can never gain one, so the bounding set is moot
# either way, and @system-service below already denies @module, @clock and
# @raw-io. Only PrivateDevices='s private /dev genuinely goes. If you ever move
# this to a system unit with User=, add all three back.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Tied to HERMES_MOBILE_STATE_DIR in the env file: override one without the
# other and push-state writes fail silently under this sandbox even though
# they work fine from a shell.
ReadWritePaths=%h/.local/state/hermes-mobile
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# V8 needs a writable-executable mapping for its JIT, so this cannot be true.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=default.target
