{
  "name": "hermes-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "An installable, tailnet-only mobile control surface for Hermes Agent.",
  "keywords": [
    "hermes",
    "hermes-agent",
    "pwa",
    "tailscale",
    "tailnet",
    "ai-agent",
    "self-hosted",
    "mobile",
    "web-push"
  ],
  "homepage": "https://github.com/ShresthaYaju/hermes-mobile#readme",
  "bugs": {
    "url": "https://github.com/ShresthaYaju/hermes-mobile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShresthaYaju/hermes-mobile.git"
  },
  "license": "MIT",
  "author": "Yaju Shrestha",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "public",
    "systemd",
    "server.mjs",
    "notifications.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "format": "prettier --write 'public/**/*.{js,css}' '*.mjs' 'test/*.mjs'",
    "check": "for f in *.mjs public/*.js public/lib/*.js public/views/*.js test/*.mjs; do node --check \"$f\" || exit 1; done && prettier --check 'public/**/*.{js,css}' '*.mjs' 'test/*.mjs'"
  },
  "dependencies": {
    "http-proxy-3": "^2.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
